# Required when NODE_ENV=production or SECRETS_STRICT=true (no localhost fallback).
REDIS_URL=redis://localhost:6380
DATABASE_URL=postgresql://synqit:synqit@localhost:5435/synqit
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
TOKEN_ENC_KEY=replace-me
EMAIL_PROVIDER=log
EMAIL_SUPPRESS_SEND=false
EMAIL_FROM=Synqit <no-reply@example.com>
EMAIL_REPLY_TO=
# Required at startup when EMAIL_PROVIDER=resend.
RESEND_API_KEY=replace-me
# Optional public landing-site URL for email logo links.
# If omitted, the logo falls back to WEB_APP_URL.
SITE_URL=https://synqit.com
