PORT=3001
HOST=0.0.0.0
APP_VERSION=0.1.0
COMMIT_SHA=dev
DATABASE_URL=postgresql://synqit:synqit@localhost:5435/synqit
REDIS_URL=redis://localhost:6380
# Secrets: required. Placeholder or short (<32 chars) values are tolerated in
# development with a warning and REJECTED when NODE_ENV=production or
# SECRETS_STRICT=true. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
TOKEN_ENC_KEY=replace-me
# Rotating TOKEN_ENC_KEY: move the old value here, set the new one above, deploy.
# Existing provider tokens keep decrypting and are re-encrypted with the new key as
# providers refresh them. Remove this once rotation has settled.
# TOKEN_ENC_KEY_PREVIOUS=
# SECRETS_STRICT=true
AUTH_REGISTRATION_EMAIL_ENABLED=false
AUTH_PASSWORD_RESET_EMAIL_ENABLED=true
# Weekly recap email (off by default; the scheduler only sends when enabled)
WEEKLY_RECAP_ENABLED=false
WEEKLY_RECAP_CHECK_INTERVAL_MS=3600000
WEEKLY_RECAP_SEND_DAY=1
WEEKLY_RECAP_SEND_HOUR_UTC=9
WEEKLY_RECAP_WINDOW_DAYS=7
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
REGISTRATION_INVITE_TTL_HOURS=168
ADMIN_EMAIL_PREVIEW_KEY=replace-me
# Emergency admin bootstrap (POST /v1/admin/bootstrap/promote). Off unless
# ADMIN_BOOTSTRAP_ENABLED=true. Key must be >=32 chars and not a placeholder.
# Once a super admin exists the route refuses further promotions unless
# ADMIN_BOOTSTRAP_ALLOW_WHEN_SUPER_ADMIN_EXISTS=true. Every attempt is audited.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_KEY=replace-me
# ADMIN_BOOTSTRAP_ALLOW_WHEN_SUPER_ADMIN_EXISTS=false
# Operational endpoints. /metrics requires this bearer token (Prometheus uses it);
# in production the endpoint is disabled until the token is set.
# /docs (Swagger UI) is off in production unless API_DOCS_ENABLED=true.
METRICS_TOKEN=
# API_DOCS_ENABLED=true
# Add the app and admin domains when running behind Caddy, for example:
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4174,http://127.0.0.1:4174
OAUTH_STATE_TTL_SECONDS=600
SPOTIFY_CLIENT_ID=replace-me
SPOTIFY_CLIENT_SECRET=replace-me
# Behind Caddy, use the app domain API path, for example:
# SPOTIFY_REDIRECT_URI=https://app.example.com/api/v1/auth/spotify/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/v1/auth/spotify/callback
SPOTIFY_SCOPES=playlist-read-private playlist-read-collaborative playlist-modify-private playlist-modify-public
SPOTIFY_AUTH_BASE_URL=https://accounts.spotify.com/authorize
SPOTIFY_TOKEN_URL=https://accounts.spotify.com/api/token
APPLE_TEAM_ID=replace-me
APPLE_KEY_ID=replace-me
APPLE_MUSICKIT_IDENTIFIER=replace-me
APPLE_PRIVATE_KEY_P8=replace-me
APPLE_SCOPES=music-library-read music-library-modify
APPLE_STOREFRONT=us
# Behind Caddy with a separate site and app, set for example:
# API_BASE_URL=https://app.example.com/api
# WEB_APP_URL=https://app.example.com
# EVENT_LINK_BASE_URL=https://app.example.com
API_BASE_URL=http://localhost:3001
WEB_APP_URL=http://127.0.0.1:5173
EVENT_LINK_BASE_URL=http://127.0.0.1:5173
AVATAR_STORAGE_DIR=./data/uploads/avatars
AVATAR_MAX_BYTES=8000000
