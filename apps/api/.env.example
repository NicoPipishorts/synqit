PORT=3001
HOST=0.0.0.0
APP_VERSION=0.1.0
COMMIT_SHA=dev
DATABASE_URL=postgresql://synqit:synqit@localhost:5435/synqit
REDIS_URL=redis://localhost:6380
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
TOKEN_ENC_KEY=replace-me
AUTH_REGISTRATION_EMAIL_ENABLED=false
AUTH_PASSWORD_RESET_EMAIL_ENABLED=true
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
REGISTRATION_INVITE_TTL_HOURS=168
ADMIN_EMAIL_PREVIEW_KEY=replace-me
ADMIN_BOOTSTRAP_KEY=replace-me
# Add the app and admin domains when running behind Caddy, for example:
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4174,http://127.0.0.1:4174
OAUTH_STATE_TTL_SECONDS=600
SPOTIFY_CLIENT_ID=replace-me
SPOTIFY_CLIENT_SECRET=replace-me
# Behind Caddy, use the app domain API path, for example:
# SPOTIFY_REDIRECT_URI=https://app.example.com/api/v1/auth/spotify/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/v1/auth/spotify/callback
SPOTIFY_SCOPES=playlist-read-private playlist-read-collaborative playlist-modify-private playlist-modify-public
SPOTIFY_AUTH_BASE_URL=https://accounts.spotify.com/authorize
SPOTIFY_TOKEN_URL=https://accounts.spotify.com/api/token
APPLE_TEAM_ID=replace-me
APPLE_KEY_ID=replace-me
APPLE_MUSICKIT_IDENTIFIER=replace-me
APPLE_PRIVATE_KEY_P8=replace-me
APPLE_SCOPES=music-library-read music-library-modify
APPLE_STOREFRONT=us
# Behind Caddy with a separate site and app, set for example:
# API_BASE_URL=https://app.example.com/api
# WEB_APP_URL=https://app.example.com
# EVENT_LINK_BASE_URL=https://app.example.com
API_BASE_URL=http://localhost:3001
WEB_APP_URL=http://127.0.0.1:5173
EVENT_LINK_BASE_URL=http://127.0.0.1:5173
AVATAR_STORAGE_DIR=./data/uploads/avatars
AVATAR_MAX_BYTES=8000000
