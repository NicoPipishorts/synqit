generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model event_tracks {
  id                BigInt   @id @default(autoincrement())
  event_id          String
  provider_track_id String
  name              String
  artist            String
  album             String
  duration_ms       Int
  artwork_url       String?
  added_at          DateTime @db.Timestamptz(6)
  added_by          String
  events            events   @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([event_id, provider_track_id])
  @@index([event_id], map: "idx_event_tracks_event_id")
  @@map("playlist_tracks")
}

model events {
  id                    String          @id
  host_user_id          String
  provider              String
  provider_playlist_id  String
  status                String
  close_reason          String?
  name                  String
  description           String
  magic_link_token      String          @unique
  magic_link_revoked_at DateTime?       @db.Timestamptz(6)
  created_at            DateTime        @db.Timestamptz(6)
  updated_at            DateTime        @db.Timestamptz(6)
  closed_at             DateTime?       @db.Timestamptz(6)
  cover_image_url       String?
  event_tracks          event_tracks[]
  event_follows         event_follows[]
  event_visits          event_visits[]
  users                 users           @relation(fields: [host_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([host_user_id], map: "idx_events_host_user_id")
  @@map("playlists")
}

model eventDrafts {
  id           String   @id
  host_user_id String
  provider     String?
  name         String
  description  String
  step         Int      @default(1)
  created_at   DateTime @db.Timestamptz(6)
  updated_at   DateTime @db.Timestamptz(6)
  users        users    @relation(fields: [host_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([host_user_id], map: "idx_event_drafts_host_user_id")
  @@map("playlist_drafts")
}

model integrations {
  id                 String    @id
  user_id            String
  provider           String
  access_token_json  Json
  refresh_token_json Json
  scopes             String[]  @default([])
  expires_at         DateTime? @db.Timestamptz(6)
  last_refresh_at    DateTime? @db.Timestamptz(6)
  last_error         String?
  created_at         DateTime  @db.Timestamptz(6)
  updated_at         DateTime  @db.Timestamptz(6)
  users              users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, provider])
  @@index([user_id, provider], map: "idx_integrations_user_id_provider")
}

model oauth_states {
  id            String   @id
  state         String   @unique
  user_id       String
  provider      String
  code_verifier String?
  created_at    DateTime @db.Timestamptz(6)
  expires_at    DateTime @db.Timestamptz(6)
  users         users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model refresh_tokens {
  id                   String    @id
  user_id              String
  token_hash           String    @unique
  created_at           DateTime  @db.Timestamptz(6)
  expires_at           DateTime  @db.Timestamptz(6)
  revoked_at           DateTime? @db.Timestamptz(6)
  replaced_by_token_id String?
  users                users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model password_reset_tokens {
  id         String    @id
  user_id    String
  token_hash String    @unique
  created_at DateTime  @db.Timestamptz(6)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_password_reset_tokens_user_id")
}

model user_profiles {
  user_id      String    @id
  display_name String?
  first_name   String?
  last_name    String?
  birth_date   DateTime? @db.Date
  country      String?
  created_at   DateTime  @db.Timestamptz(6)
  updated_at   DateTime  @db.Timestamptz(6)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model user_preferences {
  user_id    String   @id
  theme      String?
  locale     String?
  created_at DateTime @db.Timestamptz(6)
  updated_at DateTime @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model user_auth_identities {
  id               String   @id
  user_id          String
  provider         String
  provider_user_id String
  password_hash    String?
  created_at       DateTime @db.Timestamptz(6)
  updated_at       DateTime @db.Timestamptz(6)
  users            users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, provider_user_id])
  @@unique([user_id, provider])
  @@index([user_id], map: "idx_user_auth_identities_user_id")
}

model users {
  id                     String                   @id
  email                  String                   @unique
  role                   String                   @default("user")
  is_blocked             Boolean                  @default(false)
  blocked_at             DateTime?                @db.Timestamptz(6)
  account_state          String                   @default("active")
  is_test_account        Boolean                  @default(false)
  deletion_requested_at  DateTime?                @db.Timestamptz(6)
  deletion_scheduled_for DateTime?                @db.Timestamptz(6)
  deleted_at             DateTime?                @db.Timestamptz(6)
  deletion_reason        String?
  test_reset_at          DateTime?                @db.Timestamptz(6)
  password_hash          String?
  avatar_url             String?
  created_at             DateTime                 @db.Timestamptz(6)
  auth_identities        user_auth_identities[]
  admin_permissions      user_admin_permissions[]
  analytics_events       analyticsEvents[]
  event_drafts           eventDrafts[]
  events                 events[]
  event_follows          event_follows[]
  event_visits           event_visits[]
  integrations           integrations[]
  oauth_states           oauth_states[]
  password_reset_tokens  password_reset_tokens[]
  refresh_tokens         refresh_tokens[]
  user_profile           user_profiles?
  user_preferences       user_preferences?
  playlist_syncs         playlist_syncs[]
  playlist_sync_imports  playlist_sync_imports[]
  transfer_batches       transfer_batches[]
  external_imports       external_imports[]

  @@index([account_state], map: "idx_users_account_state")
  @@index([deletion_scheduled_for], map: "idx_users_deletion_scheduled_for")
  @@index([is_test_account], map: "idx_users_is_test_account")
}

/// Operator-editable runtime settings, one JSON document per key.
model app_settings {
  key                String   @id
  value_json         Json
  updated_at         DateTime @db.Timestamptz(6)
  updated_by_user_id String?
}

model admin_audit_logs {
  id             String   @id
  actor_user_id  String?
  actor_email    String?
  target_user_id String?
  target_email   String?
  action         String
  reason         String?
  metadata_json  Json?
  created_at     DateTime @db.Timestamptz(6)

  @@index([action], map: "idx_admin_audit_logs_action")
  @@index([created_at], map: "idx_admin_audit_logs_created_at")
  @@index([target_user_id], map: "idx_admin_audit_logs_target_user_id")
}

model event_follows {
  id         String   @id
  event_id   String
  user_id    String
  created_at DateTime @db.Timestamptz(6)
  updated_at DateTime @db.Timestamptz(6)
  events     events   @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([event_id, user_id])
  @@index([event_id], map: "idx_playlist_follows_event_id")
  @@index([user_id], map: "idx_playlist_follows_user_id")
  @@map("playlist_follows")
}

model event_visits {
  id         String   @id
  event_id   String
  user_id    String
  created_at DateTime @db.Timestamptz(6)
  updated_at DateTime @db.Timestamptz(6)
  events     events   @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([event_id, user_id])
  @@index([event_id], map: "idx_playlist_visits_event_id")
  @@index([user_id], map: "idx_playlist_visits_user_id")
  @@map("playlist_visits")
}

model playlist_syncs {
  id                           String                         @id
  sender_user_id               String
  provider                     String
  provider_playlist_id         String
  name                         String
  track_count                  Int?
  kind                         String                         @default("shared")
  sync_mode                    String                         @default("host_only")
  auto_sync_enabled            Boolean                        @default(true)
  next_poll_at                 DateTime?                      @db.Timestamptz(6)
  unchanged_poll_streak        Int                            @default(0)
  last_source_snapshot_id      String?
  last_source_fingerprint      String?
  last_polled_at               DateTime?                      @db.Timestamptz(6)
  last_synced_at               DateTime?                      @db.Timestamptz(6)
  last_error                   String?
  magic_link_token             String                         @unique
  magic_link_revoked_at        DateTime?                      @db.Timestamptz(6)
  created_at                   DateTime                       @db.Timestamptz(6)
  updated_at                   DateTime                       @db.Timestamptz(6)
  users                        users                          @relation(fields: [sender_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  playlist_sync_imports        playlist_sync_imports[]
  playlist_sync_track_activity playlist_sync_track_activity[]
  transfer_items               transfer_items[]

  @@index([sender_user_id], map: "idx_playlist_syncs_sender_user_id")
  @@index([kind], map: "idx_playlist_syncs_kind")
}

model transfer_batches {
  id                   String           @id
  user_id              String
  source_provider      String
  destination_provider String
  status               String           @default("queued")
  created_at           DateTime         @db.Timestamptz(6)
  updated_at           DateTime         @db.Timestamptz(6)
  completed_at         DateTime?        @db.Timestamptz(6)
  users                users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  transfer_items       transfer_items[]

  @@index([user_id], map: "idx_transfer_batches_user_id")
  @@index([status], map: "idx_transfer_batches_status")
}

model transfer_items {
  id                   String                 @id
  batch_id             String
  provider_playlist_id String
  name                 String
  track_count          Int?
  position             Int
  status               String                 @default("queued")
  sync_id              String?
  matched_count        Int?
  skipped_count        Int?
  error_message        String?
  created_at           DateTime               @db.Timestamptz(6)
  updated_at           DateTime               @db.Timestamptz(6)
  transfer_batches     transfer_batches       @relation(fields: [batch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  playlist_syncs       playlist_syncs?        @relation(fields: [sync_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  transfer_item_tracks transfer_item_tracks[]

  @@unique([batch_id, provider_playlist_id], map: "uniq_transfer_items_batch_playlist")
  @@index([batch_id], map: "idx_transfer_items_batch_id")
  @@index([status], map: "idx_transfer_items_status")
}

/// What became of each source track: written once the playlist has landed, so
/// the transfer details page can show which songs made it across without
/// asking the providers again.
model transfer_item_tracks {
  id                            String         @id
  transfer_item_id              String
  position                      Int
  source_provider_track_id      String
  name                          String
  artist                        String
  album                         String
  artwork_url                   String?
  duration_ms                   Int?
  /// 'matched' when the track landed on the destination, 'skipped' otherwise.
  status                        String
  destination_provider_track_id String?
  /// What the destination calls the track it matched. Kept so a transfer can be
  /// audited without asking the provider what an id points at.
  destination_name              String?
  destination_artist            String?
  created_at                    DateTime       @db.Timestamptz(6)
  transfer_items                transfer_items @relation(fields: [transfer_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([transfer_item_id, position], map: "uniq_transfer_item_tracks_item_position")
  @@index([transfer_item_id], map: "idx_transfer_item_tracks_item_id")
}

model playlist_sync_imports {
  id                                  String         @id
  sync_id                             String
  recipient_user_id                   String
  recipient_provider                  String
  recipient_provider_playlist_id      String?
  last_recipient_snapshot_id          String?
  synced_source_track_fingerprints    String[]       @default([])
  synced_recipient_track_fingerprints String[]       @default([])
  status                              String         @default("pending")
  matched_count                       Int?
  skipped_count                       Int?
  last_synced_at                      DateTime?      @db.Timestamptz(6)
  last_error                          String?
  created_at                          DateTime       @db.Timestamptz(6)
  updated_at                          DateTime       @db.Timestamptz(6)
  playlist_syncs                      playlist_syncs @relation(fields: [sync_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                               users          @relation(fields: [recipient_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sync_id, recipient_user_id])
  @@index([sync_id], map: "idx_playlist_sync_imports_sync_id")
  @@index([recipient_user_id], map: "idx_playlist_sync_imports_recipient_user_id")
}

model playlist_sync_track_activity {
  id                String         @id
  sync_id           String
  track_fingerprint String
  provider_track_id String
  name              String
  artist            String
  album             String
  artwork_url       String?
  first_seen_at     DateTime       @db.Timestamptz(6)
  created_at        DateTime       @db.Timestamptz(6)
  updated_at        DateTime       @db.Timestamptz(6)
  playlist_syncs    playlist_syncs @relation(fields: [sync_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sync_id, track_fingerprint])
  @@index([sync_id], map: "idx_playlist_sync_track_activity_sync_id")
  @@index([sync_id, first_seen_at], map: "idx_playlist_sync_track_activity_sync_id_first_seen_at")
}

/// Rolled up rather than one row per call: an admin dashboard wants the shape
/// of the spend, and a party's worth of guest searches would otherwise be a
/// party's worth of rows.
model provider_api_usage {
  id            String   @id
  /// Midnight UTC of the day being counted.
  day           DateTime @db.Date
  provider      String
  /// events | shared_list | transfer | link_import | account | other
  domain        String
  /// search | write | read | auth
  operation     String
  request_count Int      @default(0)
  /// Quota units where the service publishes them (YouTube), else requests.
  unit_count    Int      @default(0)
  created_at    DateTime @db.Timestamptz(6)
  updated_at    DateTime @db.Timestamptz(6)

  @@unique([day, provider, domain, operation], map: "uniq_provider_api_usage_bucket")
  @@index([day], map: "idx_provider_api_usage_day")
  @@index([provider], map: "idx_provider_api_usage_provider")
}

model notification_runs {
  id         String   @id
  kind       String
  period_key String
  claimed_at DateTime @db.Timestamptz(6)
  created_at DateTime @db.Timestamptz(6)

  @@unique([kind, period_key])
  @@index([kind], map: "idx_notification_runs_kind")
}

model user_admin_permissions {
  user_id      String
  scope        String
  access_level String
  created_at   DateTime @db.Timestamptz(6)
  updated_at   DateTime @db.Timestamptz(6)
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, scope])
  @@index([user_id], map: "idx_user_admin_permissions_user_id")
}

model analyticsEvents {
  id         String   @id
  user_id    String?
  session_id String
  event_name String
  target     String
  page_path  String
  locale     String?
  source     String
  referrer   String?
  properties Json     @default("{}")
  created_at DateTime @db.Timestamptz(6)
  users      users?   @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([created_at], map: "idx_analytics_events_created_at")
  @@index([event_name], map: "idx_analytics_events_event_name")
  @@index([target], map: "idx_analytics_events_target")
  @@index([user_id], map: "idx_analytics_events_user_id")
  @@map("analytics_events")
}

model external_imports {
  id                             String    @id
  user_id                        String
  source                         String
  source_url                     String
  source_playlist_id             String
  name                           String
  cover_image_url                String?
  recipient_provider             String
  recipient_provider_playlist_id String?
  /// Tracks of a file import, which has no source to re-read at run time.
  source_tracks_json             Json?
  status                         String    @default("pending")
  total_count                    Int       @default(0)
  matched_count                  Int       @default(0)
  skipped_count                  Int       @default(0)
  last_error                     String?
  created_at                     DateTime  @db.Timestamptz(6)
  updated_at                     DateTime  @db.Timestamptz(6)
  completed_at                   DateTime? @db.Timestamptz(6)
  users                          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_external_imports_user_id")
  @@index([status], map: "idx_external_imports_status")
}
