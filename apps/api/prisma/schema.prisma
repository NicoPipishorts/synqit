generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model event_tracks {
  id                BigInt   @id @default(autoincrement())
  event_id          String
  provider_track_id String
  name              String
  artist            String
  album             String
  duration_ms       Int
  artwork_url       String?
  added_at          DateTime @db.Timestamptz(6)
  added_by          String
  events            events   @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([event_id, provider_track_id])
  @@index([event_id], map: "idx_event_tracks_event_id")
  @@map("playlist_tracks")
}

model events {
  id                    String         @id
  host_user_id          String
  provider              String
  provider_playlist_id  String
  status                String
  close_reason          String?
  name                  String
  description           String
  magic_link_token      String         @unique
  magic_link_revoked_at DateTime?      @db.Timestamptz(6)
  created_at            DateTime       @db.Timestamptz(6)
  updated_at            DateTime       @db.Timestamptz(6)
  closed_at             DateTime?      @db.Timestamptz(6)
  cover_image_url       String?
  event_tracks          event_tracks[]
  users                 users          @relation(fields: [host_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([host_user_id], map: "idx_events_host_user_id")
  @@map("playlists")
}

model eventDrafts {
  id          String   @id
  host_user_id String
  provider    String?
  name        String
  description String
  step        Int      @default(1)
  created_at  DateTime @db.Timestamptz(6)
  updated_at  DateTime @db.Timestamptz(6)
  users       users    @relation(fields: [host_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([host_user_id], map: "idx_event_drafts_host_user_id")
  @@map("playlist_drafts")
}

model integrations {
  id                 String    @id
  user_id            String
  provider           String
  access_token_json  Json
  refresh_token_json Json
  scopes             String[]  @default([])
  expires_at         DateTime? @db.Timestamptz(6)
  last_refresh_at    DateTime? @db.Timestamptz(6)
  last_error         String?
  created_at         DateTime  @db.Timestamptz(6)
  updated_at         DateTime  @db.Timestamptz(6)
  users              users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, provider])
  @@index([user_id, provider], map: "idx_integrations_user_id_provider")
}

model oauth_states {
  id         String   @id
  state      String   @unique
  user_id    String
  provider   String
  created_at DateTime @db.Timestamptz(6)
  expires_at DateTime @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model refresh_tokens {
  id                   String    @id
  user_id              String
  token_hash           String    @unique
  created_at           DateTime  @db.Timestamptz(6)
  expires_at           DateTime  @db.Timestamptz(6)
  revoked_at           DateTime? @db.Timestamptz(6)
  replaced_by_token_id String?
  users                users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model password_reset_tokens {
  id         String    @id
  user_id    String
  token_hash String    @unique
  created_at DateTime  @db.Timestamptz(6)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_password_reset_tokens_user_id")
}

model user_profiles {
  user_id      String    @id
  display_name String?
  first_name   String?
  last_name    String?
  birth_date   DateTime? @db.Date
  country      String?
  created_at   DateTime  @db.Timestamptz(6)
  updated_at   DateTime  @db.Timestamptz(6)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model user_preferences {
  user_id    String   @id
  theme      String?
  locale     String?
  created_at DateTime @db.Timestamptz(6)
  updated_at DateTime @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model user_auth_identities {
  id               String   @id
  user_id          String
  provider         String
  provider_user_id String
  password_hash    String?
  created_at       DateTime @db.Timestamptz(6)
  updated_at       DateTime @db.Timestamptz(6)
  users            users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, provider_user_id])
  @@unique([user_id, provider])
  @@index([user_id], map: "idx_user_auth_identities_user_id")
}

model users {
  id             String           @id
  email          String           @unique
  role           String           @default("user")
  is_blocked     Boolean          @default(false)
  blocked_at     DateTime?        @db.Timestamptz(6)
  password_hash  String?
  avatar_url     String?
  created_at     DateTime         @db.Timestamptz(6)
  auth_identities user_auth_identities[]
  admin_permissions user_admin_permissions[]
  analytics_events analyticsEvents[]
  event_drafts   eventDrafts[]
  events         events[]
  integrations   integrations[]
  oauth_states   oauth_states[]
  password_reset_tokens password_reset_tokens[]
  refresh_tokens refresh_tokens[]
  user_profile   user_profiles?
  user_preferences user_preferences?
}

model user_admin_permissions {
  user_id      String
  scope        String
  access_level String
  created_at   DateTime @db.Timestamptz(6)
  updated_at   DateTime @db.Timestamptz(6)
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, scope])
  @@index([user_id], map: "idx_user_admin_permissions_user_id")
}

model analyticsEvents {
  id         String   @id
  user_id    String?
  session_id String
  event_name String
  target     String
  page_path  String
  locale     String?
  source     String
  referrer   String?
  properties Json     @default("{}")
  created_at DateTime @db.Timestamptz(6)
  users      users?   @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([created_at], map: "idx_analytics_events_created_at")
  @@index([event_name], map: "idx_analytics_events_event_name")
  @@index([target], map: "idx_analytics_events_target")
  @@index([user_id], map: "idx_analytics_events_user_id")
  @@map("analytics_events")
}
