<?xml version="1.0" encoding="utf-8"?>
<!-- Same two layers as ic_launcher.xml. Without this, launchers asking for the
     round icon fall back to the legacy ic_launcher_round.png instead of letting
     the system mask the adaptive art. No <monochrome> layer, for the reason
     given next door. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@mipmap/ic_launcher_background"/>
  <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
