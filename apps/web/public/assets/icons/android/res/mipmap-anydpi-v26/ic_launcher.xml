<?xml version="1.0" encoding="utf-8"?>
<!-- No <monochrome> layer: the icon batch ships no monochrome art, and Android 13+
     themed icons fall back to this adaptive icon, which is better than the stale
     mark the previous single-colour layer carried. Add one here if the brand ever
     produces it. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@mipmap/ic_launcher_background"/>
  <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
