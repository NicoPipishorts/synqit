{
  "name": "synqit",
  "private": true,
  "version": "0.1.0",
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:shared": "yarn workspace @synqit/shared build",
    "dev": "yarn build:shared && concurrently -n shared,site,api,worker,web,admin -c yellow,blue,cyan,magenta,green,red \"yarn workspace @synqit/shared dev\" \"yarn workspace @synqit/site dev\" \"yarn workspace @synqit/api dev\" \"yarn workspace @synqit/worker dev\" \"yarn workspace @synqit/web dev\" \"yarn workspace @synqit/admin dev\"",
    "dev:admin": "yarn workspace @synqit/admin dev",
    "dev:site": "yarn workspace @synqit/site dev",
    "dev:api": "yarn build:shared && yarn workspace @synqit/api dev",
    "dev:worker": "yarn build:shared && yarn workspace @synqit/worker dev",
    "dev:web": "yarn build:shared && yarn workspace @synqit/web dev",
    "db:check": "yarn workspace @synqit/api db:check",
    "prisma:pull": "yarn workspace @synqit/api prisma:pull",
    "prisma:generate": "yarn workspace @synqit/api prisma:generate",
    "prisma:studio": "yarn workspace @synqit/api prisma:studio",
    "prisma:migrate:dev": "yarn workspace @synqit/api prisma:migrate:dev",
    "prisma:migrate:deploy": "yarn workspace @synqit/api prisma:migrate:deploy",
    "prisma:migrate:status": "yarn workspace @synqit/api prisma:migrate:status",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:up:core": "docker compose -f infra/docker-compose.yml up -d postgres redis",
    "infra:up:obs": "docker compose -f infra/docker-compose.yml up -d prometheus grafana",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:down:obs": "docker compose -f infra/docker-compose.yml stop prometheus grafana",
    "infra:ps": "docker compose -f infra/docker-compose.yml ps",
    "infra:ps:obs": "docker compose -f infra/docker-compose.yml ps prometheus grafana",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f --tail=100",
    "infra:up:local": "docker compose --env-file infra/.env -f infra/docker-compose.yml -f infra/docker-compose.override.local.yml up -d postgres redis",
    "infra:down:local": "docker compose --env-file infra/.env -f infra/docker-compose.yml -f infra/docker-compose.override.local.yml down",
    "dev:local": "yarn infra:up:local && yarn dev",
    "build": "yarn workspaces run build",
    "lint": "yarn workspaces run lint",
    "i18n:check": "yarn workspace @synqit/web i18n:check",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "yarn workspaces run typecheck",
    "test": "yarn workspaces run test",
    "test:api:regression": "yarn workspace @synqit/api test",
    "test:web:e2e": "yarn workspace @synqit/web test:e2e",
    "test:ci": "yarn test:api:regression && yarn test:web:e2e",
    "loadtest:api": "node scripts/loadtest-api.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "resolutions": {
    "fastify": "^5.8.5",
    "fast-uri": "^3.1.1",
    "@fastify/static": "^9.1.1",
    "uuid": "^11.1.1",
    "bn.js": "^4.12.3",
    "yaml": "^2.8.3",
    "js-yaml": "^4.2.0",
    "flatted": "^3.4.2",
    "shell-quote": "^1.8.4",
    "@fastify/static/glob/minimatch": "^10.2.5",
    "@fastify/ajv-compiler/ajv": "^8.18.0",
    "ajv-formats/ajv": "^8.18.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  }
}
